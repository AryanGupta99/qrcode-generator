function doPost(e) {
  try {
    // Get the data sent from your survey app
    var params = e.parameter;
    
    // Log to Google Sheets for backup (optional)
    logToSheet(params);
    
    // Submit to Zoho Survey
    var zohoResponse = submitToZohoSurvey(params);
    
    return ContentService.createTextOutput(JSON.stringify({
      'status': 'success',
      'message': 'Survey submitted to Zoho',
      'zoho_response': zohoResponse
    })).setMimeType(ContentService.MimeType.JSON);
    
  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({
      'status': 'error',
      'message': error.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  }
}

function submitToZohoSurvey(data) {
  // Zoho Survey URL with pre-filled parameters
  var zohoUrl = 'https://survey.zohopublic.in/zs/T5Fj1T';
  
  // Build URL with parameters
  var params = {
    'sn': data.server_name || '',
    'un': data.username || '',
    '2841000002218049': data.server_performance || '3', // Server Performance field ID
    '2841000002218075': data.technical_support || '3',  // Technical Support field ID
    '2841000002218101': data.overall_rating || '3',     // Overall Rating field ID
    'feedback': data.feedback || ''
  };
  
  // Build query string
  var queryString = Object.keys(params)
    .map(function(key) {
      return encodeURIComponent(key) + '=' + encodeURIComponent(params[key]);
    })
    .join('&');
  
  var fullUrl = zohoUrl + '?' + queryString;
  
  try {
    // Attempt to submit to Zoho Survey
    var response = UrlFetchApp.fetch(fullUrl, {
      'method': 'get',
      'muteHttpExceptions': true,
      'followRedirects': true
    });
    
    return {
      'status_code': response.getResponseCode(),
      'url': fullUrl,
      'submitted': true
    };
  } catch (error) {
    return {
      'error': error.toString(),
      'url': fullUrl,
      'submitted': false
    };
  }
}

